node_modules/
dist/
build/
.env
.env.*
!.env.example
__pycache__/
*.pyc
.venv/
.DS_Store

# parity harness cache — the pre-migration side, fetched on demand
.parity-cache/

# Working directory for scripts/clean-quickstart-proof.sh (corpus checkout,
# DataHub venv, emitted proof artifacts). Regenerable; never committed.
.proof/

# Cockpit generated output (Playwright)
/apps/cockpit/test-results/
/apps/cockpit/playwright-report/
/apps/cockpit/blob-report/

# Demo production packet — rendered output only. The packet's *source* (script,
# scene targets, pronunciations, voice config) is tracked: it is small, it is
# authored, and a file that exists on one machine is a file already half-lost.
# Only the generated audio and video are ignored, because they are large,
# regenerable from the tracked source, and the final cut ships to Devpost and
# YouTube rather than to this repository.
/demo/output/
/demo/narration/output/

# Agent tooling. The cockpit design contract lives here as a skill: it is real
# working material, but it is instructions *for* building the artifact rather
# than part of it, so it stays out of the judging corpus and on disk.
.claude/
